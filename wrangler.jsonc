{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "daily-quotes",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"secrets": {
		"required": ["QUOTE_API", "UPSTASH_REDIS_REST_URL", "UPSTASH_REDIS_REST_TOKEN"]
	},
	"workers_dev": true,
	"routes": [
		{
			"pattern": "quotes.phons.dev",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	}
}
